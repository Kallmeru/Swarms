# Copy this file to .env and fill in your own values. .env is gitignored,
# never commit real credentials, past incidents in this repo are exactly
# why: a real Gemini key and Gmail app password ended up committed once.
#
# Everything here is optional. The security kernel (core/), the pipeline
# (swarm/), the benchmark and the API all run fully offline and fully
# deterministically with none of it set. That is deliberate: the defense is
# code, not a model, and it should be possible to verify that without an
# account anywhere.

# ---------------------------------------------------------------------------
# Live LLM agents (optional)
# ---------------------------------------------------------------------------
# Set this and the pipeline's three agents route their reasoning through a
# real model instead of deterministic templates. Containment does not change,
# which is the point: the same injected document hijacks a real model just as
# it hijacks the offline heuristic, and gets stopped at the same place by the
# same code.
#
#   SWARMS_LLM=groq       -> needs GROQ_API_KEY    (free tier, fastest)
#   SWARMS_LLM=openai     -> needs OPENAI_API_KEY
#   SWARMS_LLM=gemini     -> needs GEMINI_API_KEY  (free tier)
#   SWARMS_LLM=none       -> offline agents (default)
SWARMS_LLM=none
# SWARMS_LLM_MODEL=llama-3.3-70b-versatile
# SWARMS_LLM_BASE_URL=          # any OpenAI-compatible host: OpenRouter, vLLM, Ollama
# SWARMS_LLM_TIMEOUT=30

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Server (optional)
# ---------------------------------------------------------------------------
# PORT=8000
# HOST=0.0.0.0
# SWARMS_RATE_LIMIT=30          # /api/run calls per minute per client
# SWARMS_CORS_ORIGINS=*         # comma-separated; narrow it if you add state
# SWARMS_RUNS_DIR=runs          # where persisted event logs go

# ---------------------------------------------------------------------------
# attack_lab alerting (optional, disconnected from the demo path)
# ---------------------------------------------------------------------------
# Only ScannerAgent.send_alert() reads these. The live demo shows the alert
# email it *would* compose and never sends one.
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_TO=security@example.com
ALERT_FROM=

# Score threshold (0-1) above which ScannerAgent.scan() flags an alert.
SCANNER_THRESHOLD=0.6
