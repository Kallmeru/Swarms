# Copy this file to .env and fill in your own values. .env is gitignored,
# never commit real credentials, past incidents in this repo are exactly
# why: a real Gemini key and Gmail app password ended up committed once.
#
# Only attack_lab/ (the prompt-injection scanner prototype) reads these.
# Nothing else in this project needs a .env or any external API key, the
# core taint/capability demo (core/, swarm/, web/) is fully offline and
# deterministic on purpose.

# Required for attack_lab's LLM-assisted sanitizer rewrite. Get a free key
# from https://aistudio.google.com/apikey. Without it, GeminiClient.generate()
# raises a clear error instead of silently failing, the scanner and basic
# sanitizer still work fully without this.
GEMINI_API_KEY=

# Required only for attack_lab's ScannerAgent.send_alert() email feature.
# Use an app password (not your real account password), e.g. a Gmail App
# Password: https://myaccount.google.com/apppasswords
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_TO=security@example.com
ALERT_FROM=

# Score threshold (0-1) above which ScannerAgent.scan() flags an alert.
SCANNER_THRESHOLD=0.6
