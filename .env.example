# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
# All of this is optional. The SDK and the decision engine run with none of it
# set: the policy is a file, the audit log is SQLite, and nothing on the
# enforcement path calls out to anything.

# ---------------------------------------------------------------------------
# Policy and storage
# ---------------------------------------------------------------------------
# Where the policy lives. Unset, the engine walks up from the working
# directory looking for swarms.yaml, then falls back to the bundled default.
# SWARMS_POLICY=/etc/swarms/swarms.yaml

# Audit database. Put it on a volume that survives a redeploy: it is the
# record of what the system decided.
# SWARMS_DB=/data/swarms.db

# 0 puts the engine in observe-only mode: decisions are computed and recorded,
# nothing is blocked. Deploy that way first, read the audit log for a week,
# then turn it on.
# SWARMS_ENFORCE=1

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Required before exposing the gateway. Format: key[:name[:role]], comma
# separated. Roles: admin (resolve approvals, reload policy), service (decide
# and record), viewer (read only). Generate one with: swarms keygen
# SWARMS_API_KEYS=swk_xxx:ci:service,swk_yyy:alice:admin

# Set this and the gateway refuses to start without API keys.
# SWARMS_ENV=production

# HOST=0.0.0.0
# PORT=8000
# SWARMS_CORS_ORIGINS=https://console.example.com
# SWARMS_SESSION_TTL=3600
# SWARMS_MAX_SESSIONS=10000

# ---------------------------------------------------------------------------
# Live model agents (red-team suite only, optional)
# ---------------------------------------------------------------------------
# The red-team pipeline runs on deterministic templates by default so the
# suite is reproducible. Set a provider and the three agents route through a
# real model instead. Containment does not change, which is the point worth
# being able to demonstrate rather than assert.
#
#   SWARMS_LLM=groq    -> GROQ_API_KEY     (free tier, fastest)
#   SWARMS_LLM=openai  -> OPENAI_API_KEY
#   SWARMS_LLM=gemini  -> GEMINI_API_KEY
SWARMS_LLM=none
# SWARMS_LLM_MODEL=llama-3.3-70b-versatile
# SWARMS_LLM_BASE_URL=          # any OpenAI-compatible host: OpenRouter, vLLM, Ollama
# SWARMS_LLM_TIMEOUT=30

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Threshold above which the advisory content scanner flags text. It never
# gates anything.
SCANNER_THRESHOLD=0.6
